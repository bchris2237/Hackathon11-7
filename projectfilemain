<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Comparative advantage calculator</title>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f2f5f7;--surface:#fff;--ink:#16202b;--muted:#5b6876;--line:#cfd8e0;--a:#1d6fb8;--b:#8a3fa8;--good:#13795b;--bad:#b4302a;--grid:#e3e9ee;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f161d;--surface:#17212b;--ink:#e8eef4;--muted:#9aa8b6;--line:#2b3947;--a:#5aa6ea;--b:#c58be0;--good:#4cc79d;--bad:#ff8a80;--grid:#223140}}
:root[data-theme="dark"]{--bg:#0f161d;--surface:#17212b;--ink:#e8eef4;--muted:#9aa8b6;--line:#2b3947;--a:#5aa6ea;--b:#c58be0;--good:#4cc79d;--bad:#ff8a80;--grid:#223140}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "IBM Plex Sans",system-ui,sans-serif}
main{max-width:980px;margin:0 auto;padding:28px 18px 56px}
h1{font:600 clamp(28px,5vw,40px)/1.15 "Newsreader",Georgia,serif;margin:0 0 6px}
h2{font:600 22px/1.2 "Newsreader",Georgia,serif;margin:0 0 10px}
p.lead{color:var(--muted);margin:0 0 24px;max-width:62ch}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:18px;margin-bottom:18px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media(max-width:700px){.cols{grid-template-columns:1fr}}
.goods{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px;align-items:center;color:var(--muted)}
input[type=text]{font:inherit;padding:5px 8px;border:1px solid var(--line);border-radius:4px;background:var(--bg);color:var(--ink);width:110px}
.cA h2{color:var(--a)}.cB h2{color:var(--b)}
.row{display:grid;grid-template-columns:1fr auto;gap:2px 10px;margin:12px 0}
.row label{color:var(--muted);font-size:14px}.row output{font-weight:600;font-variant-numeric:tabular-nums}
.row input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--ink)}
.cA input[type=range]{accent-color:var(--a)}.cB input[type=range]{accent-color:var(--b)}
table{width:100%;border-collapse:collapse;font-size:15px;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line)}
th{font-weight:500;color:var(--muted)}
.scroll{overflow-x:auto}
.pos{color:var(--good);font-weight:600}.neg{color:var(--bad);font-weight:600}
.note{background:var(--bg);border-left:3px solid var(--ink);padding:10px 14px;margin:12px 0 0;border-radius:0 4px 4px 0}
.charts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:700px){.charts{grid-template-columns:1fr}}
svg{width:100%;height:auto;display:block}
svg text{fill:var(--muted);font:12px "IBM Plex Sans",sans-serif}
.legend{display:flex;gap:18px;flex-wrap:wrap;font-size:14px;color:var(--muted);margin-top:8px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px}
.big{font:600 28px "Newsreader",Georgia,serif}
.sub{color:var(--muted);font-size:14px}
.ask{display:flex;gap:8px;flex-wrap:wrap}
.ask input[type=text]{flex:1 1 260px;width:auto;padding:9px 11px}
button{font:inherit;font-weight:500;border:1px solid var(--ink);background:var(--ink);color:var(--bg);border-radius:4px;padding:9px 16px;cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
button.chip{background:transparent;color:var(--ink);border-color:var(--line);padding:5px 11px;font-size:14px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 0}
#answer{white-space:pre-wrap;margin-top:14px;min-height:1.5em}
#answer.err{color:var(--bad)}
:focus-visible{outline:2px solid var(--a);outline-offset:2px}
</style>
</head>
<body>
<main>
<h1>Who should make what, and what should they trade?</h1>
<p class="lead">Set how much each country can produce in one day if it spends the whole day on a single good. The calculator finds each country’s opportunity costs, who should specialize, and the range of trade prices that leave both better off.</p>

<div class="panel">
  <div class="goods">
    <span>Good 1</span><input type="text" id="g1" value="wheat" aria-label="Name of good 1">
    <span>Good 2</span><input type="text" id="g2" value="cloth" aria-label="Name of good 2">
  </div>
  <div class="cols">
    <div class="cA"><h2>Country A</h2><div id="slA"></div></div>
    <div class="cB"><h2>Country B</h2><div id="slB"></div></div>
  </div>
</div>

<div class="panel">
  <h2>Opportunity costs</h2>
  <div class="scroll"><table id="oc"></table></div>
  <div id="verdict" class="note"></div>
</div>

<div class="panel" id="tradePanel">
  <h2>Set the terms of trade</h2>
  <div class="cols">
    <div class="row"><label for="price" id="priceLbl">Price</label><output id="priceOut"></output>
      <input type="range" id="price" min="0" max="1000" value="500"></div>
    <div class="row"><label for="vol" id="volLbl">Trade volume</label><output id="volOut"></output>
      <input type="range" id="vol" min="0" max="100" value="50"></div>
  </div>
  <p class="sub" id="range"></p>
  <div class="scroll"><table id="res"></table></div>
  <div id="pitfall" class="note" hidden></div>
</div>

<div class="panel">
  <h2>Production possibilities</h2>
  <div class="charts"><div id="chA"></div><div id="chB"></div></div>
  <div class="legend">
    <span><i style="background:var(--muted)"></i>Self-sufficient (half the day on each good)</span>
    <span><i style="background:var(--good)"></i>After specializing and trading</span>
  </div>
  <p class="sub">A consumption point outside a country’s own frontier is only reachable through trade. Both panels share one scale.</p>
</div>

<div class="panel">
  <h2>Ask about this scenario</h2>
  <p class="sub" id="askHint">Checking whether AI answers are available…</p>
  <div class="ask">
    <input type="text" id="q" placeholder="e.g. Why does Country A still gain?" aria-label="Your question" maxlength="300">
    <button id="askBtn" disabled>Ask</button>
  </div>
  <div class="chips" id="chips"></div>
  <div id="answer" aria-live="polite"></div>
</div>
</main>

<script>
const $=id=>document.getElementById(id);
let ctx='';
const base=(g1,g2,P)=>`Goods: ${g1} (good 1) and ${g2} (good 2). Maximum output per day if a country spends the whole day on one good: Country A ${P.A.X} ${g1} or ${P.A.Y} ${g2}; Country B ${P.B.X} ${g1} or ${P.B.Y} ${g2}. Before trade, each country spends half its day on each good.`;
const defs={A:[6,3],B:[2,4]};
const sl={A:[],B:[]};
function mk(c){
  const host=$('sl'+c);
  [0,1].forEach(i=>{
    const d=document.createElement('div');d.className='row';
    d.innerHTML=`<label for="${c}${i}"></label><output id="${c}${i}o"></output><input type="range" id="${c}${i}" min="1" max="100" step="1" value="${defs[c][i]}">`;
    host.appendChild(d);
    sl[c][i]=d.querySelector('input');
    sl[c][i].addEventListener('input',update);
  });
}
mk('A');mk('B');
['g1','g2','price','vol'].forEach(id=>$(id).addEventListener('input',update));
const f=(n,d=2)=>(Math.round(n*10**d)/10**d).toString();
const sgn=n=>(n>0?'+':'')+f(n);

function chart(host,color,X,Y,S,before,after,spec,g1,g2){
  const W=360,H=330,m={l:44,r:14,t:14,b:40},pw=W-m.l-m.r,ph=H-m.t-m.b;
  const sx=v=>m.l+v/S*pw,sy=v=>m.t+ph-v/S*ph;
  let g='';
  const step=S>60?20:S>25?10:S>12?5:S>6?2:1;
  for(let v=0;v<=S;v+=step){
    g+=`<line x1="${sx(v)}" x2="${sx(v)}" y1="${m.t}" y2="${m.t+ph}" stroke="var(--grid)"/><line x1="${m.l}" x2="${m.l+pw}" y1="${sy(v)}" y2="${sy(v)}" stroke="var(--grid)"/>`;
    g+=`<text x="${sx(v)}" y="${H-22}" text-anchor="middle">${v}</text><text x="${m.l-8}" y="${sy(v)+4}" text-anchor="end">${v}</text>`;
  }
  g+=`<line x1="${m.l}" x2="${m.l}" y1="${m.t}" y2="${m.t+ph}" stroke="var(--muted)"/><line x1="${m.l}" x2="${m.l+pw}" y1="${m.t+ph}" y2="${m.t+ph}" stroke="var(--muted)"/>`;
  g+=`<text x="${m.l+pw/2}" y="${H-4}" text-anchor="middle">${g1} per day</text><text transform="translate(12 ${m.t+ph/2}) rotate(-90)" text-anchor="middle">${g2} per day</text>`;
  g+=`<polygon points="${sx(0)},${sy(0)} ${sx(X)},${sy(0)} ${sx(0)},${sy(Y)}" fill="${color}" fill-opacity=".12"/>`;
  g+=`<line x1="${sx(X)}" y1="${sy(0)}" x2="${sx(0)}" y2="${sy(Y)}" stroke="${color}" stroke-width="2.5"/>`;
  if(spec){
    g+=`<line x1="${sx(spec[0])}" y1="${sy(spec[1])}" x2="${sx(after[0])}" y2="${sy(after[1])}" stroke="var(--good)" stroke-width="2" stroke-dasharray="5 4"/>`;
    g+=`<circle cx="${sx(spec[0])}" cy="${sy(spec[1])}" r="5" fill="var(--surface)" stroke="var(--good)" stroke-width="2"/>`;
  }
  g+=`<circle cx="${sx(before[0])}" cy="${sy(before[1])}" r="6" fill="var(--muted)"/>`;
  g+=`<circle cx="${sx(after[0])}" cy="${sy(after[1])}" r="7" fill="var(--good)"/>`;
  host.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Production possibilities frontier"><title>Frontier</title>${g}</svg>`;
}

function update(){
  const g1=$('g1').value.trim()||'good 1',g2=$('g2').value.trim()||'good 2';
  const P={A:{X:+sl.A[0].value,Y:+sl.A[1].value},B:{X:+sl.B[0].value,Y:+sl.B[1].value}};
  ['A','B'].forEach(c=>{
    [g1,g2].forEach((g,i)=>{
      document.querySelector(`label[for=${c}${i}]`).textContent=`Max ${g} per day`;
      $(c+i+'o').textContent=sl[c][i].value;
    });
  });
  // opportunity cost of one unit of good 2 in units of good 1 (g1 given up)
  const o2={A:P.A.X/P.A.Y,B:P.B.X/P.B.Y};
  const o1={A:1/o2.A,B:1/o2.B};
  $('oc').innerHTML=`<tr><th></th><th>1 ${g1} costs</th><th>1 ${g2} costs</th></tr>
   <tr><td>Country A</td><td>${f(o1.A)} ${g2}</td><td>${f(o2.A)} ${g1}</td></tr>
   <tr><td>Country B</td><td>${f(o1.B)} ${g2}</td><td>${f(o2.B)} ${g1}</td></tr>`;
  const equal=Math.abs(o2.A-o2.B)<1e-9;
  const V=$('verdict'),T=$('tradePanel');
  const absAll=(P.A.X>=P.B.X&&P.A.Y>=P.B.Y&&(P.A.X>P.B.X||P.A.Y>P.B.Y))||(P.B.X>=P.A.X&&P.B.Y>=P.A.Y&&(P.B.X>P.A.X||P.B.Y>P.A.Y));
  const pit=$('pitfall');
  if(equal){
    V.textContent=`Both countries give up the same amount to make each good, so neither has a comparative advantage and trade creates no gains. Change a slider to break the tie.`;
    T.hidden=true;
    ctx=base(g1,g2,P)+` Both countries have the same opportunity cost (${f(o2.A)} ${g1} per ${g2}), so neither has a comparative advantage and trade creates no gains.`;
    ['chA','chB'].forEach(id=>$(id).innerHTML='');
    const S=Math.max(P.A.X,P.A.Y,P.B.X,P.B.Y)*1.1;
    chart($('chA'),'var(--a)',P.A.X,P.A.Y,S,[P.A.X/2,P.A.Y/2],[P.A.X/2,P.A.Y/2],null,g1,g2);
    chart($('chB'),'var(--b)',P.B.X,P.B.Y,S,[P.B.X/2,P.B.Y/2],[P.B.X/2,P.B.Y/2],null,g1,g2);
    return;
  }
  T.hidden=false;
  const c2=o2.A<o2.B?'A':'B',c1=c2==='A'?'B':'A'; // c2 makes good 2, c1 makes good 1
  V.innerHTML=`<b>Country ${c2}</b> should specialize in ${g2} (it gives up only ${f(o2[c2])} ${g1} per ${g2}, versus ${f(o2[c1])} for Country ${c1}). <b>Country ${c1}</b> should specialize in ${g1}.`;
  const lo=Math.min(o2.A,o2.B),hi=Math.max(o2.A,o2.B);
  const pr=lo+(+$('price').value/1000)*(hi-lo);
  $('priceLbl').textContent=`Price: ${g1} per 1 ${g2}`;
  $('priceOut').textContent=f(pr);
  $('range').textContent=`Both sides gain only when the price falls between ${f(lo)} and ${f(hi)} ${g1} per ${g2}. The slider moves across that range.`;
  const Tmax=Math.min(P[c2].Y,P[c1].X/pr);
  const frac=+$('vol').value/100,t=frac*Tmax;
  $('volLbl').textContent=`Trade volume: ${g2} sold by Country ${c2}`;
  $('volOut').textContent=`${f(t)} ${g2}`;
  const before={A:[P.A.X/2,P.A.Y/2],B:[P.B.X/2,P.B.Y/2]};
  const spec={};spec[c2]=[0,P[c2].Y];spec[c1]=[P[c1].X,0];
  const after={};
  after[c2]=[pr*t,P[c2].Y-t];
  after[c1]=[P[c1].X-pr*t,t];
  const idx=c=>after[c][0]/P[c].X+after[c][1]/P[c].Y; // >1 means outside own frontier
  const row=c=>{
    const b=before[c],a=after[c],k=idx(c),dw=a[0]-b[0],dc=a[1]-b[1];
    const cls=v=>v>1e-9?'pos':v<-1e-9?'neg':'';
    return `<tr><td>Country ${c}</td><td>${f(b[0])} ${g1}, ${f(b[1])} ${g2}</td><td>${f(spec[c][0])} ${g1}, ${f(spec[c][1])} ${g2}</td><td>${f(a[0])} ${g1}, ${f(a[1])} ${g2}</td>
    <td><span class="${cls(dw)}">${sgn(dw)}</span> ${g1}, <span class="${cls(dc)}">${sgn(dc)}</span> ${g2}</td>
    <td class="${k>1.0001?'pos':k<0.9999?'neg':''}">${k>1.0001?'+'+f((k-1)*100,1)+'% beyond own frontier':k<0.9999?'inside own frontier':'on frontier'}</td></tr>`;
  };
  $('res').innerHTML=`<tr><th></th><th>Before trade</th><th>Produces</th><th>Consumes after trade</th><th>Change</th><th>Verdict</th></tr>${row('A')}${row('B')}`;
  if(absAll){
    const better=(P.A.X>=P.B.X&&P.A.Y>=P.B.Y)?'A':'B';
    pit.hidden=false;
    pit.innerHTML=`Country ${better} can make more of both goods, yet it still gains from trade. What matters is comparative advantage (the lower opportunity cost), not absolute productivity.`;
  } else pit.hidden=true;
  const S=Math.max(P.A.X,P.A.Y,P.B.X,P.B.Y)*1.1;
  ctx=base(g1,g2,P)+` Opportunity cost of 1 ${g2}: Country A gives up ${f(o2.A)} ${g1}, Country B gives up ${f(o2.B)} ${g1}. Country ${c2} should specialize in ${g2} and Country ${c1} in ${g1}. Mutually beneficial price range: ${f(lo)} to ${f(hi)} ${g1} per 1 ${g2}. Current price: ${f(pr)}. Current trade volume: Country ${c2} sells ${f(t)} ${g2}. After trade Country A consumes ${f(after.A[0])} ${g1} and ${f(after.A[1])} ${g2}; Country B consumes ${f(after.B[0])} ${g1} and ${f(after.B[1])} ${g2}. Better-at-everything case: ${absAll?'yes':'no'}.`;
  chart($('chA'),'var(--a)',P.A.X,P.A.Y,S,before.A,after.A,spec.A,g1,g2);
  chart($('chB'),'var(--b)',P.B.X,P.B.Y,S,before.B,after.B,spec.B,g1,g2);
}
update();

// Ask-a-question box: uses the viewer's Claude access when the page runs on claude.ai.
(async()=>{
  const hint=$('askHint'),btn=$('askBtn'),q=$('q'),out=$('answer');
  const chips=['Why does specializing help?','What if Country A’s cloth output doubled?','Why does a country that is better at everything still gain?'];
  let sample=null;
  try{ sample=(window.claude&&claude.use)?await claude.use('sample'):null; }catch(e){ sample=null; }
  if(!sample){
    hint.textContent='AI answers work only on the published claude.ai version of this page. The calculator itself works everywhere.';
    q.disabled=true;
    return;
  }
  hint.textContent='Ask anything about the numbers above. Answers use your current slider settings, and all calculations on this page come from the calculator’s own code.';
  btn.disabled=false;
  let ctl=null;
  async function ask(text){
    text=(text||q.value).trim();
    if(!text)return;
    q.value=text;
    if(ctl)ctl.abort();
    ctl=new AbortController();
    btn.disabled=true;out.className='';out.textContent='Thinking…';
    const prompt=`You are a friendly economics tutor inside a calculator about comparative advantage and trade. Answer the student’s question using the scenario below. Rely on the calculator’s figures instead of inventing new ones. If the question changes the numbers (a what-if), work through the opportunity costs step by step and suggest they set the sliders to check. Keep it under 150 words, in plain text with no markdown or bullet symbols.\n\nSCENARIO: ${ctx}\n\nSTUDENT QUESTION: ${text}`;
    try{
      const r=await sample(prompt,{signal:ctl.signal,cache:false,modelTier:'quick',onText:({text:t})=>{out.textContent=t;}});
      out.textContent=r.text;
    }catch(e){
      if(e&&e.code==='not_granted'){out.className='err';out.textContent='Permission to ask Claude was not granted, so no answer is available.';}
      else if(e&&e.code==='rate_limited'){out.className='err';out.textContent='Too many questions in a short time. Wait a moment and try again.';}
      else if(e&&e.name==='AbortError'){}
      else{out.className='err';out.textContent='Something went wrong getting an answer. Try again in a moment.';}
    }finally{btn.disabled=false;}
  }
  btn.addEventListener('click',()=>ask());
  q.addEventListener('keydown',e=>{if(e.key==='Enter')ask();});
  chips.forEach(c=>{const b=document.createElement('button');b.className='chip';b.type='button';b.textContent=c;b.addEventListener('click',()=>ask(c));$('chips').appendChild(b);});
})();
</script>
</body>
</html>