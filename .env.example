# TradeMind environment variable NAMES ONLY. Copy to .env for local use.
# Never put real credentials, tokens or passwords in this file or in git.
# AWS credentials come from the standard AWS credential chain locally
# (AWS_PROFILE / aws configure sso) and from the Lambda execution role in AWS.

# ---- Backend (Python / Lambda) ----
# fixture = explicitly simulated local mode (the Phase 0 default)
# live    = real adapters. Starts even if some are missing: those routes answer an explicit 503 (never a fake result).
#           A deployed stack (infra/template.yaml) always runs live.
APP_MODE=fixture
# Exact origin(s) allowed by CORS, comma separated, no wildcard. Never a secret.
# Local dev needs both hostnames because the Vite page may be opened as either.
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Set by the build/deploy pipeline; "unknown" when unset
COMMIT_SHA=
# Seconds an adapter (Bedrock, solver, storage) may run before the API answers 503 ADAPTER_TIMEOUT.
# 0.1 to 28. API Gateway HTTP APIs cut integrations off at 30 s.
ADAPTER_TIMEOUT_SECONDS=25
# Most adapter calls running at once (1 to 16). More get 429 THROTTLED with Retry-After. /health is never limited.
MAX_IN_FLIGHT=4
# Local server bind (python -m backend.local)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- Backend: AWS (not needed for Phase 0) ----
# The project NEVER guesses these. With APP_MODE=live and either one empty, POST /extract answers 503 NOT_CONFIGURED.
AWS_REGION=
# A model id or inference profile id your account has been granted access to. Look it up in the Bedrock console.
BEDROCK_MODEL_ID=
# Optional tuning for extraction (defaults shown). Output tokens 100-4000, read timeout 1-25 seconds.
BEDROCK_MAX_OUTPUT_TOKENS=1500
BEDROCK_READ_TIMEOUT_SECONDS=10
# on = also send Bedrock's JSON-schema structured output. Only turn on for a model that supports it; the first
# call with a new schema can take ~90 s to compile, longer than API Gateway's 30 s limit. Default off.
BEDROCK_STRUCTURED_OUTPUT=off
# Local only. Lambda uses its execution role instead.
AWS_PROFILE=
# Optional enhancements
PROFILE_TABLE=
REPORT_BUCKET=

# ---- Frontend (Vite; these two are the ONLY frontend variables) ----
# Put them in frontend/.env.local. Public values only: never AWS credentials.
VITE_API_BASE_URL=http://127.0.0.1:8000
# fixture | live
VITE_DATA_MODE=fixture
